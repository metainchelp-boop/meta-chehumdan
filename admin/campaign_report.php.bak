<script>
	//블로그 최근 5일 방문자
	$("[id*='blog_chart_']").each(function(){

		var id = $(this).attr('id');
		var blog_id = $(this).data('ref');

		console.log('id='+id, 'blog_id='+blog_id);

		$.ajax({
			type     : "post",
			url      : nfor_path + "/admin/ajax_blog_count_chart.php",
			data     : "blog_id="+blog_id,
			async    : false,
			success  : function(data) {
				var arr = data.split("|:|");
				//console.log('arr', arr[0], arr[1], arr[2], arr[3]);

				labels = arr[1].split(',');
				datas = arr[2].split(',');
				total_count = arr[3];

				if(arr[0] == 'SUCCESS') {

					/*막대챠트 data */
					var blog_data = {
						labels: labels,
						datasets: [{
							label: '최근 5일간 방문자 수',
							backgroundColor: window.chartColors.blue,
							data: datas
						} ]
					};
					respondCanvas(id, blog_data);

					$('#blog_totalcount_'+blog_id).html('블로그ID : '+ blog_id +', 총합계 : ' + total_count);
				} else {

					$('#blog_totalcount_'+blog_id).html('블로그ID : '+ blog_id +', 총합계 : 0');
				}

			},
			error: function(){
				console.log("Ajax failed");
			}
		});
	});

	function respondCanvas(id, blog_data) {
		/*막대챠트*/
		var blog_chart = document.getElementById(id).getContext('2d');
		window.myBar = new Chart(blog_chart, {
			type: 'bar',
			data: blog_data,
			options: {
				tooltips: {
					mode: 'index',
					intersect: false
				},
				responsive: true,
				scales: {
					xAxes: [{
						stacked: true,
					}],
					yAxes: [{
						stacked: true
					}]
				}
			}
		});
		/*막대챠트*/
	}
</script>


